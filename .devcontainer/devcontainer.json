{
  "name": "integrative_post_gwas_methods_course",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bullseye",

  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },

  "postCreateCommand": "uv venv && uv sync && uv pip install 'git+https://github.com/arnor-sigurdsson/EIR-auto-GP.git@27928f'",
  "waitFor": "postCreateCommand"
}
